# Question 7: Array Indexing and Slicing (NumPy)
# ==========================================================
print("\n--- Question 7 ---")
arr = np.array([
    [10, 20, 30],
    [40, 50, 60],
    [70, 80, 90]
])

print("Original Array:\n", arr)
print("\nSpecific element (row 1, col 2):", arr[1, 2])
print("Entire row 1:", arr[1, :])
print("Entire column 1:", arr[:, 1])
print("Sliced array (2x2 top-left):\n", arr[0:2, 0:2])


