# Question 8: Arithmetic Operations on Arrays vs Lists
# ==========================================================
print("\n--- Question 8 ---")
arr1 = np.array([1, 2, 3, 4])
arr2 = np.array([5, 6, 7, 8])

print("NumPy Addition      :", arr1 + arr2)
