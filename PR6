<?php
$message = "";
$result = "";

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $technology = trim($_POST['technology'] ?? '');
    $a = filter_input(INPUT_POST, 'a', FILTER_VALIDATE_FLOAT);
    $b = filter_input(INPUT_POST, 'b', FILTER_VALIDATE_FLOAT);
    $op = $_POST['op'] ?? '+';

    if ($technology !== '') {
        $message = "Suggestion received for: " . htmlspecialchars($technology);
    }

    if ($a !== false && $a !== null && $b !== false && $b !== null) {
        switch ($op) {
            case '+':
                $result = $a + $b;
                break;
            case '-':
                $result = $a - $b;
                break;
            case '*':
                $result = $a * $b;
                break;
            case '/':
                $result = ($b != 0) ? ($a / $b) : 'Cannot divide by zero';
                break;
            default:
                $result = 'Invalid operation';
        }
    }
}
?>
