    <h1>PHP Mathematical Operations</h1>

    <?php if ($message): ?>
        <p style="color: green;"><strong><?php echo $message; ?></strong></p>
    <?php endif; ?>

    <?php if ($result !== ""): ?>
        <p><strong>Calculator result:</strong> <?php echo htmlspecialchars((string)$result); ?></p>
    <?php endif; ?>

    <form method="post" action="">
        <label>Technology suggestion: <input type="text" name="technology"></label><br><br>
