// ==========================================================
// Question 2: Mathematical Operations
// ==========================================================
$a = 10;
$b = 5;

echo "Addition: " . ($a + $b) . "<br>";
echo "Subtraction: " . ($a - $b) . "<br>";
echo "Multiplication: " . ($a * $b) . "<br>";
echo "Division: " . ($b != 0 ? ($a / $b) : "Cannot divide by zero") . "<br><br>";


// ==========================================================
// Question 3: Simple Calculator
// ==========================================================
$val_a = (float)($_POST['a'] ?? 10);
$val_b = (float)($_POST['b'] ?? 5);
$op = $_POST['op'] ?? '+';

if ($op === '+') {
    $answer = $val_a + $val_b;
} elseif ($op === '-') {
    $answer = $val_a - $val_b;
} elseif ($op === '*') {
    $answer = $val_a * $val_b;
} elseif ($op === '/') {
    $answer = ($val_b != 0) ? ($val_a / $val_b) : 'Cannot divide by zero';
} else {
    $answer = 'Invalid operation';
}

echo "Calculator Answer: " . htmlspecialchars((string)$answer);
?>

